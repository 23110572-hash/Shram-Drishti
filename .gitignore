# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ---- node ----
node_modules/
dist/
.vite/
# TypeScript incremental build caches. Machine-specific and regenerated on build.
*.tsbuildinfo

# ---- runtime data ----
# Uploaded documents and rendered page images. Never committed: these are workers'
# pay records.
storage/objects/
storage/_tmp/
*.db
*.sqlite3

# The statutory source text in storage/ IS committed — every rule cites the file
# and provision it was read from, so a reviewer needs those files present to check
# any threshold.
!storage/*.md

# ---- generated test corpus ----
# Regenerate with: python -m app.cli build-corpus --scanned
corpus/
corpus_clean/

# ---- scratch ----
_*.txt

# ---- editors / os ----
.vscode/
.idea/
.DS_Store
Thumbs.db
